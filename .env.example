# Copy to .env and set your own provider keys. Keys are used only by server.ts.
# Rotate any key previously committed to Git before configuring it here.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# Optional server settings. Generation requires a verified Firebase user.
PORT=3000
AI_REQUEST_TIMEOUT_MS=90000

# Public origin used by hosting integrations, if needed.
APP_URL="http://localhost:3000"
